# Server
BOT_HOST=0.0.0.0
BOT_PORT=8080
# Required (24+ random characters) for non-loopback BOT_HOST; protects /status and /metrics.
BOT_ADMIN_TOKEN=
LOG_LEVEL=info
DATA_DIR=/app/data
SESSION_STORE=file
SESSION_FILE_PATH=/app/data/sessions.json
SESSION_TTL_MINUTES=120
CONTEXT_BOUNDED=true
CONTEXT_MAX_TURNS=100
CONTEXT_MAX_AGE_HOURS=24
CONTEXT_MAX_STORED_CHARS=120000
CONTEXT_PROMPT_TURNS=6
CONTEXT_PROMPT_CHARS=3000
BOT_REPLY_STYLE_FILE=
BOT_REPLY_STYLE_DIR=
BOT_REPLY_STYLE_STATE_FILE=./data/reply-styles.json
REDIS_URL=
REDIS_KEY_PREFIX=qq-ai-bot
POSTGRES_URL=
POSTGRES_TABLE=qq_ai_bot_sessions
APP_GIT_COMMIT=
APP_BUILD_REF=
# Optional local-only, append-only @mention/reply archive. Blank disables; no automatic deletion.
BOT_MENTION_JOURNAL_FILE=

# Independent direct Responses backend (no Codex process/login required).
# Set CONTEXT_BOUNDED=true when selecting direct. Keep acp for legacy installations.
AI_BACKEND=direct
DIRECT_API_BASE_URL=https://api.example.com/v1
DIRECT_API_KEY_ENV=QQ_CODEX_API_KEY
QQ_CODEX_API_KEY=
DIRECT_API_MODEL=your-model-name
DIRECT_API_REASONING=medium
DIRECT_API_SEND_HISTORY=false
BOT_REPLY_RULES_FILE=
DIRECT_API_TOTAL_TIMEOUT_MS=120000
DIRECT_API_FIRST_BYTE_TIMEOUT_MS=90000
DIRECT_API_CONNECT_TIMEOUT_MS=10000
# Optional explicit loopback HTTP CONNECT proxy; never inferred from system/env proxies.
DIRECT_API_LOCAL_PROXY_URL=
DIRECT_API_MAX_RETRIES=1
DIRECT_API_MAX_INPUT_CHARS=10000
DIRECT_API_MAX_INPUT_BYTES=20000
DIRECT_API_MAX_OUTPUT_TOKENS=4096
# Keep true for standard Responses; set false only for a provider verified to reject max_tool_calls.
DIRECT_API_MAX_TOOL_CALLS_SUPPORTED=true
BOT_DIAGNOSTIC_LOG=
BOT_DIAGNOSTIC_LOG_MAX_BYTES=5242880

# ElevenLabs speech: explicit commands only; owner-private by default.
BOT_VOICE_ENABLED=false
# Opt-in: mentioned group /语音 (/voice) replies <=50 Unicode characters use voice only.
BOT_VOICE_GROUP_ENABLED=false
# Configure group voice policy; owner 0 means no per-minute limit.
BOT_VOICE_GROUP_MAX_CHARS=50
BOT_VOICE_GROUP_MEMBER_PER_MINUTE=1
BOT_VOICE_GROUP_ADMIN_PER_MINUTE=2
BOT_VOICE_GROUP_OWNER_PER_MINUTE=0
ELEVENLABS_API_KEY_FILE=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_v4_turbo
ELEVENLABS_STABILITY=0.5
# Lively delivery uses a [happy] audio tag on v4 Turbo/v3, not a text personality change.
ELEVENLABS_DELIVERY=neutral
BOT_VOICE_MAX_CHARS=300
BOT_VOICE_TIMEOUT_MS=30000
BOT_VOICE_MAX_BYTES=2097152
BOT_VOICE_DAILY_CHARS=2000
BOT_VOICE_USAGE_FILE=./data/voice-usage.json
# macOS: convert MP3 locally to Tencent SILK; NapCat's exec adapter cannot do this.
BOT_VOICE_FFMPEG_COMMAND=ffmpeg

# OneBot / QQ transport
ONEBOT_MODE=reverse
ONEBOT_ACCESS_TOKEN=
ONEBOT_FORWARD_WS_URL=ws://127.0.0.1:3001/onebot/v11/ws
ONEBOT_REVERSE_WS_HOST=0.0.0.0
ONEBOT_REVERSE_WS_PORT=16700
ONEBOT_REVERSE_WS_PATH=/onebot/v11/ws
ONEBOT_ALLOW_GROUP=false
ONEBOT_REQUIRE_MENTION_IN_GROUP=true
ONEBOT_ALLOW_PRIVATE=false
ONEBOT_ALLOW_GROUP_COMMANDS_WITHOUT_MENTION=false
ONEBOT_ALLOWED_GROUPS=
ONEBOT_BLOCKED_GROUPS=
ONEBOT_ALLOWED_USERS=
ONEBOT_OWNER_USERS=
ONEBOT_BLOCKED_USERS=
ONEBOT_COMMAND_PREFIX=/
ONEBOT_GROUP_CONFIG_FILE=/app/examples/group-rules.local.json
ONEBOT_PROGRESS_MODE=off
ONEBOT_OUTBOUND_MAX_TEXT_LENGTH=1400
ONEBOT_INBOUND_DEDUPE_WINDOW_MS=120000
ONEBOT_INBOUND_DEDUPE_MAX_ENTRIES=2048
ONEBOT_INBOUND_IMAGE_LOCAL_ROOTS=
NAPCAT_WEBUI_TOKEN=
QQ_APP_PATH=/Applications/QQ.app

# AI / ACP agent bridge
# Example (repo mock agent):
# ACP_AGENT_COMMAND=node
# ACP_AGENT_ARGS_JSON=["--import","tsx","src/examples/mock-acp-agent.ts"]
#
# Example (traex):
# ACP_AGENT_COMMAND=traex
# ACP_AGENT_ARGS_JSON=["acp","serve"]
#
# Example (repo mock agent, works out of the box after `npm install`):
ACP_AGENT_COMMAND=node
ACP_AGENT_ARGS_JSON=["--import","tsx","src/examples/mock-acp-agent.ts"]
ACP_AGENT_WORKDIR=.
ACP_CLIENT_NAME=qq-ai-bot
ACP_REUSE_SESSION=true
ACP_DEFAULT_SYSTEM_PROMPT=
ACP_VERBOSE_MODE=normal
ACP_PROGRESS_THROTTLE_MS=800
ACP_MAX_PROGRESS_UPDATES=6
ACP_PERMISSION_STRATEGY=allow_once
ACP_MAX_INBOUND_IMAGES=3
ACP_MAX_INBOUND_IMAGE_BYTES=6291456
ACP_LOCAL_VISION_OCR=false
ACP_LOCAL_VISION_OCR_COMMAND=
ACP_LOCAL_VISION_OCR_TIMEOUT_MS=30000
ACP_LOCAL_VISION_OCR_MAX_CHARS=6000

# Read-only document extraction (Python with pypdf/python-docx/openpyxl)
ACP_READ_DOCUMENTS=false
ACP_DOCUMENT_PYTHON_COMMAND=python3
ACP_MAX_INBOUND_DOCUMENTS=2
ACP_MAX_INBOUND_DOCUMENT_BYTES=10485760
ACP_MAX_DOCUMENT_CHARS=20000
ACP_DOCUMENT_TIMEOUT_MS=20000
# One-level quote expansion after sender/group/@ policy checks
ONEBOT_RESOLVE_REPLIES=false
# codex-acp CODEX_CONFIG override; existing provider/credentials are preserved
ACP_WEB_SEARCH=false
## Grok Responses 兼容：仅关闭不兼容的 Codex 多代理 namespace，保留搜索等工具。
ACP_GROK_COMPAT=false
## NapCat图片流回退：要求get_msg证明图片属于本条消息/引用，分块有界读取，不放宽DNS/路径白名单。
ONEBOT_INBOUND_IMAGE_STREAM=false
# On-demand, same-group speaker history analysis. No background collection.
ONEBOT_READ_GROUP_HISTORY=false
